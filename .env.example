# Copy to .env.local (gitignored via `.env.*`) and fill in.
# AI-Hub API key — issued at https://aihub.or.kr (마이페이지 > API 이용안내).
# Used by scripts/aihub_fetch.py. Dataset listing works without it; downloading also
# requires a *currently valid* data-use approval for each dataset on the AI-Hub site.
AIHUB_API_KEY=
